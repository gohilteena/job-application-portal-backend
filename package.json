{
  "name": "job-portal-backend",
  "version": "1.0.0",
  "description": "Job Portal Backend API (Express 5, TypeScript, MongoDB Atlas, JWT, Zod, Multer)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "seed": "tsx src/seed.ts",
    "seed:prod": "node dist/seed.js",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.4",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
