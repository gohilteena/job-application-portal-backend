PORT=5000
NODE_ENV=development
# MongoDB Atlas SRV string, include the database name (e.g. /job_portal)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/job_portal?retryWrites=true&w=majority
# Generate each: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"  (min 32 chars, must differ)
JWT_ACCESS_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12
# Optional: comma-separated allowed CORS origins (empty = allow all)
CORS_ORIGIN=
